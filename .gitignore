# --- Vivado generated/build artifacts ---
# Vivado/CNN_Accelerator.xpr IS tracked on purpose - open it directly on a
# new machine instead of re-running Scripts/build.tcl. Only the bulky,
# machine-specific, regenerable folders below are ignored.
Vivado/*.cache/
Vivado/*.hw/
Vivado/*.ip_user_files/
Vivado/*.runs/
Vivado/*.sim/
Vivado/*.srcs/
Vivado/*.xpr.backup*
*.jou
*.log
*.str
vivado*.jou
vivado*.log
webtalk*.log
webtalk*.jou

# --- Simulation waveforms / work libraries ---
*.wdb
*.vcd
*.fst
work/
transcript
modelsim.ini

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json

# --- Icarus Verilog local sim artifacts (Phase 9 quick-iteration flow) ---
sim/

# --- Stray Vivado run-report artifact ---
dfx_runtime.txt
