# ============================== 
# Vivado generated/build artifacts
# ==============================
# Keep source files, Tcl scripts, XDC constraints and documentation tracked.
# Ignore machine-specific Vivado projects, caches, simulation databases,
# synthesis/implementation runs and generated IP data.
Vivado/**/*.cache/
Vivado/**/*.hw/
Vivado/**/*.ip_user_files/
Vivado/**/*.runs/
Vivado/**/*.sim/
Vivado/**/*.srcs/
Vivado/**/*.gen/
Vivado/**/*.xpr.backup*
Vivado_2px/**/*.cache/
Vivado_2px/**/*.hw/
Vivado_2px/**/*.ip_user_files/
Vivado_2px/**/*.runs/
Vivado_2px/**/*.sim/
Vivado_2px/**/*.srcs/
Vivado_2px/**/*.gen/
Vivado_2px/**/*.xpr.backup*
Vivado_2px_MP4/**/*.cache/
Vivado_2px_MP4/**/*.hw/
Vivado_2px_MP4/**/*.ip_user_files/
Vivado_2px_MP4/**/*.runs/
Vivado_2px_MP4/**/*.sim/
Vivado_2px_MP4/**/*.srcs/
Vivado_2px_MP4/**/*.gen/
Vivado_2px_MP4/**/*.xpr.backup*

# Vivado logs / reports generated beside projects
*.jou
*.log
*.str
vivado*.jou
vivado*.log
webtalk*.log
webtalk*.jou

